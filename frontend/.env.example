# Server-only (Netlify) — never NEXT_PUBLIC_
API_BACKEND_URL=http://localhost:8000
API_USERNAME=
API_PASSWORD=

# Browser: set true on Netlify so fetches go to /api/backend (proxy injects Basic Auth)
NEXT_PUBLIC_USE_API_PROXY=false

# Local direct-to-FastAPI when proxy is false
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production: require login cookie before the dashboard (pair with SITE_TOTP_SECRET on API)
# NEXT_PUBLIC_REQUIRE_LOGIN=true
