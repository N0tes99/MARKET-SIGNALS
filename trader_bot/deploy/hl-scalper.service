[Unit]
Description=HL scalper paper loop (S1/S2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit these paths for your host:
WorkingDirectory=/opt/hl-scalper
# pip install -e /path/to/trader_bot
ExecStart=/usr/bin/python3 -m hl_scalper.loop --mode paper --maker --ensemble --coins BTC,ETH --data-dir /opt/hl-scalper/data --interval 2
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Optional: HL_ENSEMBLE=true HL_MAKER=true HL_USE_WS=true

NoNewPrivileges=true
PrivateTmp=true

# Kill switch clears only on process restart — intentional.
# Do not put HL_MASTER_PRIVATE_KEY here. Agent key only if/when live.

[Install]
WantedBy=multi-user.target
