# Application
APP_NAME=Signal Engine
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production
# Social JWT cookie lifetime (minutes); default 14 days
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# HTTP Basic Auth (empty AUTH_PASSWORD = auth off, local default)
AUTH_USERNAME=signal
AUTH_PASSWORD=

# Shared Authenticator gate (TOTP) + access grants.
# Flow: register/login → admin grants access (/admin/access) → enter YOUR authenticator
# code → dashboard. Empty SITE_TOTP_SECRET = gate off (local default).
# Generate secret + QR URI:
#   cd backend && python -c "import pyotp; s=pyotp.random_base32(); print('SITE_TOTP_SECRET='+s); print(pyotp.TOTP(s).provisioning_uri('site', issuer_name='Signal Engine'))"
SITE_TOTP_SECRET=
SITE_TOTP_ISSUER=Signal Engine
SITE_GATE_EXPIRE_HOURS=12

# Social usernames allowed to see Outcome log (TP / Hit / Miss). Comma-separated.
ADMIN_USERNAMES=Admin
# Comma-separated; include your Netlify origin in production
CORS_ORIGINS=http://localhost:3000
# Frontend URL for email verification links (defaults to first CORS origin)
PUBLIC_APP_URL=http://localhost:3000

# Database
POSTGRES_USER=signal_engine
POSTGRES_PASSWORD=signal_engine
POSTGRES_DB=signal_engine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://signal_engine:signal_engine@localhost:5432/signal_engine

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Market data freshness (product degraded flag — not TTL SWR)
MARKET_DATA_STALE_SECONDS=900
MARKET_DATA_FAILURE_THRESHOLD=3

# LLM analysis (optional). Leave both blank = local synthesizer (free, uses F&G + tape).
# Do not put a paid OpenAI key on Render unless you accept usage bills.
OPENAI_API_KEY=
# Google AI Studio free quota: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Market Data
BINANCE_SPOT_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com
KRAKEN_API_URL=https://api.kraken.com
FRED_API_KEY=
# Coinglass — optional paid liquidations. Leave blank (recommended unless you already pay).
# Without it, Derivatives still uses free Binance/Bybit funding + OI.
COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v4.coinglass.com
COINGLASS_EXCHANGE_LIST=Binance,OKX,Bybit

# Alpaca read-only mirror (positions + recent fills). Leave blank to hide/disable.
# Never used for order execution — intelligence-only mirror of your brokerage book.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper (default): https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets  (must match the key environment)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market Data API host for free-tier IEX activity snapshots (NOT Trading API).
# Always requests feed=iex — never SIP / Algo Trader Plus. Yahoo stays primary OHLCV.
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Learning / outcomes / paper / Discord alert cooldowns
# Use postgres (or auto) in production so state survives Render restarts.
SIGNAL_STORE=auto

# Alerts (grade >= B and confidence >= 65 by default)
ALERT_ENABLED=false
ALERT_MIN_CONFIDENCE=65
ALERT_MIN_GRADE=B
ALERT_COOLDOWN_MINUTES=120
# Discord bot (create at https://discord.com/developers/applications)
ALERT_DISCORD_BOT_TOKEN=
ALERT_DISCORD_CHANNEL_ID=
# Optional Discord webhook (can use with bot — both fire if set)
ALERT_DISCORD_WEBHOOK_URL=
# Email via SMTP (Gmail: smtp.gmail.com:587 + app password)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_USE_TLS=true

# Frontend (local direct API; see frontend/.env.example for Netlify proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_API_PROXY=false
